model businesses {
  id                                                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                                          String               @db.Uuid
  name                                              String
  slug                                              String               @unique @db.Citext
  description                                       String?
  logo_id                                           String?              @db.Uuid
  cover_id                                          String?              @db.Uuid
  category                                          String?
  phone                                             String?
  whatsapp_number                                   String?
  currency                                          String               @default("USD") @db.Char(3)
  is_verified                                       Boolean              @default(false)
  is_active                                         Boolean              @default(true)
  rating_avg                                        Decimal              @default(0) @db.Decimal(3, 2)
  rating_count                                      Int                  @default(0)
  created_at                                        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime             @default(now()) @db.Timestamptz(6)
  ad_boosts                                         ad_boosts[]
  business_members                                  business_members[]
  media_assets_businesses_cover_idTomedia_assets    media_assets?        @relation("businesses_cover_idTomedia_assets", fields: [cover_id], references: [id], onUpdate: NoAction)
  media_assets_businesses_logo_idTomedia_assets     media_assets?        @relation("businesses_logo_idTomedia_assets", fields: [logo_id], references: [id], onUpdate: NoAction)
  users                                             users                @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conversations                                     conversations[]
  favorites                                         favorites[]
  locations                                         locations[]
  media_assets_media_assets_business_idTobusinesses media_assets[]       @relation("media_assets_business_idTobusinesses")
  orders                                            orders[]
  payment_accounts                                  payment_accounts[]
  platform_invoices                                 platform_invoices[]
  posts                                             posts[]
  product_categories                                product_categories[]
  products                                          products[]
  reviews                                           reviews[]
  subscriptions                                     subscriptions[]
  whatsapp_accounts                                 whatsapp_accounts?
  whatsapp_messages                                 whatsapp_messages[]
  whatsapp_templates                                whatsapp_templates[]

  @@index([owner_id], map: "idx_businesses_owner")
}

